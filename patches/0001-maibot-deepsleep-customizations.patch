new file mode 100644
index 000000000..92450c529
--- /dev/null
+++ b/src/maisaka/builtin_tool/send_gallery_pic.py
@@ -0,0 +1,112 @@
+"""发送图库里已有的人像照片，避免每次都重新生图。"""
+
+import base64
+import json
+from pathlib import Path
+from typing import Optional
+
+from src.common.data_models.message_component_data_model import ImageComponent
+from src.common.data_models.mai_message_data_model import MessageSequence
+from src.core.tooling import ToolExecutionContext, ToolExecutionResult, ToolInvocation, ToolSpec
+
+from .context import BuiltinToolRuntimeContext, PostProcessedReplyMessage
+
+GALLERY_PATH = Path(__file__).resolve().parents[3] / "plugins" / "a-dawn_oaimage" / "assets" / "outfits" / "gallery.json"
+
+
+def _load_gallery() -> list[dict]:
+    """读取图库索引；读不到就返回空（工具会降级为提示）。"""
+    try:
+        if not GALLERY_PATH.is_file():
+            return []
+        return json.loads(GALLERY_PATH.read_text(encoding="utf-8"))
+    except Exception:
+        return []
+
+
+def get_tool_spec() -> ToolSpec:
+    gallery = _load_gallery()
+    if gallery:
+        options = "；".join(
+            f"{index}. {item.get('scene', '')}（{item.get('outfit', '')}，{item.get('mood', '')}）"
+            for index, item in enumerate(gallery, start=1)
+        )
+    else:
+        options = "（图库为空）"
+    return ToolSpec(
+        name="send_gallery_pic",
+        description=(
+            "发送一张【已经拍好的】自己的照片，秒发、不消耗生图额度。"
+            f"现有照片：{options}。"
+            "对方要照片、要自拍、问你在干嘛时，**先看这里有没有合适的**——"
+            "场景对得上就直接发这张，比重新生成快得多（生成要等好几分钟）。"
+            "只有这里没有合适的场景时，才去用 generate_image 新画一张。"
+        ),
+        parameters_schema={
+            "type": "object",
+            "properties": {
+                "index": {
+                    "type": "integer",
+                    "description": f"要发第几张，从 1 开始，范围 1-{max(len(gallery), 1)}。",
+                    "minimum": 1,
+                    "maximum": max(len(gallery), 1),
+                },
+                "text": {
+                    "type": "string",
+                    "description": "配一句话（可选）。不填就只发图。",
+                },
+            },
+            "required": ["index"],
+        },
+        provider_name="maisaka_builtin",
+        provider_type="builtin",
+    )
+
+
+async def handle_tool(
+    tool_ctx: BuiltinToolRuntimeContext,
+    invocation: ToolInvocation,
+    context: Optional[ToolExecutionContext] = None,
+) -> ToolExecutionResult:
+    gallery = _load_gallery()
+    if not gallery:
+        return tool_ctx.build_failure_result(invocation.tool_name, "图库是空的，让用户把照片放进 assets/outfits 并重建 gallery.json。")
+
+    args = invocation.arguments or {}
+    try:
+        index = int(args.get("index", 0))
+    except (TypeError, ValueError):
+        index = 0
+    if not 1 <= index <= len(gallery):
+        return tool_ctx.build_failure_result(
+            invocation.tool_name, f"序号要在 1-{len(gallery)} 之间，你给的是 {args.get('index')}。"
+        )
+
+    item = gallery[index - 1]
+    path = Path(str(item.get("path", "")))
+    if not path.is_file():
+        return tool_ctx.build_failure_result(invocation.tool_name, f"这张照片文件不见了：{path.name}")
+
+    try:
+        data = path.read_bytes()
+    except OSError as exc:
+        return tool_ctx.build_failure_result(invocation.tool_name, f"读不到照片：{exc}")
+
+    # binary_data 必须给原始字节：发送链路靠它上传，content 只是展示用。
+    image_component = ImageComponent(
+        binary_hash=item.get("file", path.name),
+        content=base64.b64encode(data).decode("ascii"),
+        binary_data=data,
+    )
+
+    # 图片作为独立消息跟在文字后面发出去，和 reply 的附件走同一条链路。
+    post_messages: list[PostProcessedReplyMessage] = [
+        PostProcessedReplyMessage(sequence=MessageSequence([image_component]))
+    ]
+    text = str(args.get("text") or "").strip()
+    result_text = f"已发送照片：{item.get('scene', '')}"
+    return tool_ctx.build_success_result(
+        invocation.tool_name,
+        content=text or result_text,
+        post_history_messages=post_messages,
+    )
