diff --git a/src/maisaka/builtin_tool/save_emoji.py b/src/maisaka/builtin_tool/save_emoji.py
new file mode 100644
index 000000000..3f2bd087e
--- /dev/null
+++ b/src/maisaka/builtin_tool/save_emoji.py
@@ -0,0 +1,93 @@
+"""把聊天里的图片存进自己的表情包库（按指令存图，区别于自动收集）。"""
+
+from typing import Optional
+
+from src.common.data_models.message_component_data_model import ImageComponent
+from src.core.tooling import ToolExecutionContext, ToolExecutionResult, ToolInvocation, ToolSpec
+from src.emoji_system.emoji_manager import emoji_manager
+from src.maisaka.context.image_attachment import resolve_context_image
+from src.maisaka.context.messages import ContentContextMessage
+
+from .context import BuiltinToolRuntimeContext
+
+
+def get_tool_spec() -> ToolSpec:
+    return ToolSpec(
+        name="save_emoji",
+        description=(
+            "把聊天里出现过的图片保存进你自己的表情包库，之后可以像其他表情包一样发出去。"
+            "默认保存最近一张图；想存指定的某张，把那条消息的 msg_id 传进来。"
+            "保存后系统会自动识别内容并打标签，稍等片刻就能用。"
+        ),
+        parameters_schema={
+            "type": "object",
+            "properties": {
+                "msg_id": {
+                    "type": "string",
+                    "description": "要保存的图片所在消息的 msg_id；不填则保存最近一张图。",
+                },
+                "image_index": {
+                    "type": "integer",
+                    "description": "该消息里的第几张图（从 0 开始），默认 0。",
+                },
+            },
+        },
+        provider_name="maisaka_builtin",
+        provider_type="builtin",
+    )
+
+
+def _find_latest_image_msg_id(tool_ctx: BuiltinToolRuntimeContext) -> Optional[str]:
+    """从当前上下文里找最近一条带图消息的 msg_id。"""
+    for message in reversed(tool_ctx.runtime._chat_history):
+        if not isinstance(message, ContentContextMessage):
+            continue
+        if any(isinstance(component, ImageComponent) for component in message.raw_message.components):
+            return message.message_id
+    return None
+
+
+async def handle_tool(
+    tool_ctx: BuiltinToolRuntimeContext,
+    invocation: ToolInvocation,
+    context: Optional[ToolExecutionContext] = None,
+) -> ToolExecutionResult:
+    args = invocation.arguments or {}
+    msg_id = str(args.get("msg_id") or "").strip()
+    image_index = args.get("image_index", 0)
+    try:
+        image_index = int(image_index)
+    except (TypeError, ValueError):
+        image_index = 0
+
+    if not msg_id:
+        msg_id = _find_latest_image_msg_id(tool_ctx)
+        if not msg_id:
+            return tool_ctx.build_failure_result(
+                invocation.tool_name, "当前聊天里没有找到图片。让 TA 重新发一次图再存。"
+            )
+
+    try:
+        image = await resolve_context_image(tool_ctx.runtime, msg_id, image_index)
+    except ValueError as exc:
+        return tool_ctx.build_failure_result(invocation.tool_name, f"找不到要存的图片：{exc}")
+    if not image.binary_data:
+        return tool_ctx.build_failure_result(invocation.tool_name, "图片数据读取失败，稍后再试一次。")
+
+    try:
+        emoji = await emoji_manager.ensure_emoji_saved(image.binary_data)
+    except ValueError as exc:
+        return tool_ctx.build_failure_result(invocation.tool_name, str(exc))
+    except Exception as exc:  # noqa: BLE001 - 存储层异常统一转为工具失败
+        return tool_ctx.build_failure_result(invocation.tool_name, f"保存图片时出错：{exc}")
+
+    status = await emoji_manager.register_emoji_by_filename(emoji.full_path)
+    if status == "registered":
+        text = "已存入你的表情包库，自动打标后就能用了。"
+    elif status == "skipped":
+        text = "这张图已经在你的表情包库里了，不用重复存。"
+    else:
+        return tool_ctx.build_failure_result(
+            invocation.tool_name, "这张图没能入库（可能没通过内容审核或识别失败）。"
+        )
+    return tool_ctx.build_success_result(invocation.tool_name, text)
