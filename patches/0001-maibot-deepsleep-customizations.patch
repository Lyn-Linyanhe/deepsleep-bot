+def _apply_paragraph_recency_reorder(results: List[RetrievalResult], *, caller: str) -> int:
+    """按 dual_path 预计算的时效因子（recency_factor）重排段落命中。
+
+    只改顺序不改分数：阈值过滤已经用原始分完成，重排只决定进入上游
+    top_k 截断的名次。无因子的命中（关系、兜底补充等）按因子 1.0 处理。
+    """
+    if not results:
+        return 0
+    adjusted = 0
+    keyed: List[tuple[float, int, RetrievalResult]] = []
+    for index, item in enumerate(results):
+        metadata = item.metadata if isinstance(item.metadata, dict) else {}
+        raw_factor = metadata.get("recency_factor")
+        try:
+            factor = float(raw_factor) if raw_factor is not None else 1.0
+        except (TypeError, ValueError):
+            factor = 1.0
+        if raw_factor is not None:
+            adjusted += 1
+        keyed.append((float(item.score) * factor, index, item))
+    if adjusted:
+        keyed.sort(key=lambda triple: (-triple[0], triple[1]))
+        results[:] = [item for _, _, item in keyed]
+    return adjusted
+
+
